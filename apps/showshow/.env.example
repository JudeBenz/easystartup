# Copy to apps/showshow/.env.local for local production-shaped runs.

# --- Required for Postgres mode ---
DATABASE_URL=postgres://showshow:showshow@127.0.0.1:5432/showshow

# --- Auth.js ---
AUTH_SECRET=replace-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000
# Keep demo persona switcher off in production. Set 1 only for internal QA.
SHOWSHOW_DEMO_PERSONAS=0

# --- Neon Object Storage (uploads bucket) ---
# Pulled by `neon link` / `neon deploy` into .env.local
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_ENDPOINT_URL_S3=
# AWS_REGION=us-east-2
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_CONNECT_CLIENT_ID=ca_...
# 500 = 5.00% platform fee on Connect destination charges
SHOWSHOW_PLATFORM_FEE_BPS=500

# --- Email (deadline alerts) ---
# RESEND_API_KEY=re_...
# EMAIL_FROM=ShowShow <alerts@yourdomain.com>

# --- Cron (Vercel / external) ---
# CRON_SECRET=replace-with-long-random
# Protects /api/cron/deadline-reminders AND /api/cron/reconcile-ledger

# Production: omit or set to 0 to hide demo persona switcher
# SHOWSHOW_DEMO_PERSONAS=0

# --- Observability (optional; no-op when DSN unset) ---
# NEXT_PUBLIC_SENTRY_DSN=https://...@o....ingest.sentry.io/...
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1
# Sourcemap upload on CI (optional):
# SENTRY_ORG=jude-rogers
# SENTRY_PROJECT=showshow
# SENTRY_AUTH_TOKEN=sntrys_...
